{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Urls": "http://0.0.0.0:5080",
  "ConnectionStrings": {
    "GoodOffice": "Data Source=goodoffice.db"
  },
  "Simulador": {
    "Habilitado": true,
    "IntervaloSegundos": 30
  },
  "Umbrales": {
    "HoraInicio": 8,
    "HoraFin": 19,
    "Temperatura": { "Minimo": 20, "Maximo": 24, "MargenCritico": 3, "Unidad": "°C" },
    "Humedad": { "Minimo": 40, "Maximo": 60, "MargenCritico": 10, "Unidad": "%" },
    "Luminosidad": { "Minimo": 300, "Maximo": 750, "MargenCritico": 150, "Unidad": "lx" }
  },
  "Correo": {
    "UsarSmtp": false,
    "Servidor": "smtp.office365.com",
    "Puerto": 587,
    "UsarSsl": true,
    "Usuario": "",
    "Clave": "",
    "Remitente": "no-responder@goodoffice.local",
    "NombreRemitente": "Good Office",
    "CarpetaSalida": "correos"
  }
}
